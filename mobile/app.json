{
  "expo": {
    "name": "Meal Planner",
    "slug": "meal-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mealplanner.family"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4572E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mealplanner.family"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Meal Planner uses your photos so you can add a picture to a meal.",
          "cameraPermission": "Meal Planner uses the camera so you can take a picture of a meal.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "mealplanner",
    "experiments": {
      "typedRoutes": false
    }
  }
}
