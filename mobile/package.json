    "web": "node scripts/sync-core.js && expo start --web",
    "export:ios": "node scripts/sync-core.js && expo export --platform ios",
    "export:web": "node scripts/sync-core.js && expo export --platform web",
    "lint": "expo lint"
  },
  "private": true,
